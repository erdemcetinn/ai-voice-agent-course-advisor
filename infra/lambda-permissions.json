{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCatalogAndIndex",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::course-advisor-data-452383571300/*"
    },
    {
      "Sid": "ReadStudentRecords",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-1:452383571300:table/course-advisor-students"
    },
    {
      "Sid": "EmbedSearchQueries",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
    }
  ]
}
